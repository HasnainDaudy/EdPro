# EdPro Environment Configuration
NODE_ENV=development
PORT=5000

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-32-character-secret-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
# Default embedded SQLite file in ./data/edpro.sqlite
DATABASE_DIALECT=sqlite
DATABASE_FILE=./data/edpro.sqlite

# COPPA & FERPA Compliance Settings
COPPA_MINIMUM_AGE_WITHOUT_CONSENT=13
DATA_RETENTION_DAYS=365

# AI Tutor Configuration
# Supported providers: 'mock' (default, zero-key local demo), 'gemini', 'openai', 'ollama'
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
